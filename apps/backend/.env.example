PORT=3001
NODE_ENV=development

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=XXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXX
AWS_S3_THUMBNAILS_BUCKET=amala-thumbnails

DYNAMODB_TABLE_NAME=amala-data

COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Mock DynamoDB for development
# Set to a JSON string or path to a JSON file
# Example: MOCK_DYNAMODB='[{"PK":"USER#123","SK":"PROFILE","username":"test"}]'
# Or: MOCK_DYNAMODB=./mock-data.json
MOCK_DYNAMODB=
