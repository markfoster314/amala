{
  "name": "amala",
  "version": "0.1.0",
  "private": true,
  "description": "Private video file sharing service for sharing videos with friends on privately hosted servers",
  "author": "",
  "license": "MIT",
  "keywords": [
    "video-sharing",
    "private",
    "self-hosted",
    "file-sharing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/markfoster314/amala.git"
  },
  "bugs": {
    "url": "https://github.com/markfoster314/amala/issues"
  },
  "homepage": "https://github.com/markfoster314/amala#readme",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @amala/frontend dev",
    "dev:backend": "pnpm --filter @amala/backend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @amala/frontend build",
    "build:backend": "pnpm --filter @amala/backend build",
    "preview": "pnpm --filter @amala/frontend preview",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss}\"",
    "type-check": "pnpm --filter @amala/frontend type-check && pnpm --filter @amala/backend type-check",
    "test": "pnpm --filter @amala/frontend test",
    "test:watch": "pnpm --filter @amala/frontend test:watch",
    "validate": "pnpm lint && pnpm type-check && pnpm format:check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "clean:all": "pnpm clean && rm -rf node_modules",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --rmi all",
    "docker:dev": "docker-compose up"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.50.0"
  },
  "packageManager": "pnpm@8.10.0",
  "pnpm": {
    "overrides": {},
    "peerDependencyRules": {
      "ignoreMissing": []
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx,js,jsx}": [
      "cd apps/frontend && eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
